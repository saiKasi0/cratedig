# Project-wide static analysis. This is the THIRD line of RT-safety enforcement —
# RT_SCOPE() (runtime abort) is first, -fno-exceptions on rt/engine targets is
# second. src/rt/ and src/engine/ add stricter nested configs.
#
# Note on disabled checks (comments cannot live inside the folded Checks scalar
# below — YAML would fold them into the check string):
#   clang-analyzer-optin.performance.Padding
#     Cache-line padding of cross-thread state is mandatory here (CLAUDE.md:
#     "shared cross-thread state uses alignas(kCacheLine)"). This check flags
#     every correct use of it as waste — noise for this codebase by construction.
#   bugprone-easily-swappable-parameters
#     Fires on every (buffer, length) and (start, end) pair in DSP code.
#   modernize-use-trailing-return-type
#     Contradicts the house style in CLAUDE.md.
#   clang-analyzer-optin.core.EnumCastOutOfRange
#     Fires inside Catch2's assertion macros on a legitimate flag-enum pattern.
#     Path-sensitive analyzer results are not reliably suppressed by
#     HeaderFilterRegex, so the check itself has to go.
---
Checks: >
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  modernize-*,
  readability-identifier-naming,
  readability-braces-around-statements,
  readability-redundant-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-optin.core.EnumCastOutOfRange

WarningsAsErrors: '*'
# Only our own headers. Must be specific enough to exclude the FetchContent tree:
# a bare '(src|tests)/' also matches _deps/catch2-src/src/catch2/..., which made
# clang-tidy report (and, with WarningsAsErrors, fail on) third-party code.
HeaderFilterRegex: '.*/(src/(rt|engine|io|ingest|tui|lua|host)|tests/(unit|integration|compile|tui|e2e))/[^/]*\.(hpp|cpp)$'
FormatStyle: file

CheckOptions:
  # Naming per CLAUDE.md: snake_case functions/variables, PascalCase types,
  # kCamel constants, m_ members, snake_case files.
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: 'k'
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: 'k'
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'k'
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: 'k'
