---
Language: Cpp
BasedOnStyle: Google
Standard: c++20

ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
SeparateDefinitionBlocks: Always

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # Corresponding header of a .cpp gets priority 0 automatically.
  - Regex: '^<(catch2|Catch2)/'
    Priority: 4
  - Regex: '^"(rt|engine|io|ingest|tui|lua|host)/'
    Priority: 1
  - Regex: '^"'
    Priority: 1
  - Regex: '^<[a-z_]+>$'  # C++ standard library
    Priority: 3
  - Regex: '^<'           # other third-party angle includes
    Priority: 2
